# Reading Buddy — Environment Variables
# Copy this file to .env and fill in the values.

# --- Required ---
# Sarvam AI speech-to-text API key
# Get one at: https://docs.sarvam.ai
SARVAM_API_KEY=

# --- Optional ---
# Groq API key for AI-powered encouragement feedback
# If not set, static fallback messages are used
GROQ_API_KEY=

# --- Application ---
# Public URL of the app (used for absolute URL generation)
# Set this to your Render deployment URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Legacy (not actively used in MVP) ---
# These are declared in environment.d.ts but not used by the
# JSON-file-store MVP. Keep them here for future database/payment integration.
# DATABASE_URL=
# STRIPE_API_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CLERK_ADMIN_IDS=
